  "item": [
    {
      "name": "GET Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code es 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type header presente y es JSON\", function () {",
              "    pm.response.to.have.header(\"Content-Type\");",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Body es un array con al menos 1 elemento\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an(\"array\");",
              "    pm.expect(jsonData.length).to.be.above(0);",
              "});",
              "",
              "pm.test(\"Cada elemento tiene las propiedades esperadas\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData[0]).to.have.property(\"id\");",
              "    pm.expect(jsonData[0]).to.have.property(\"name\");",
              "    pm.expect(jsonData[0]).to.have.property(\"createdAt\");",
              "    pm.expect(jsonData[0]).to.have.property(\"avatar\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "response": []
