              "pm.test(\"Guardar productId en variables de entorno\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.environment.set(\"productId\", jsonData.id);",
              "    pm.expect(pm.environment.get(\"productId\")).to.exist;",
              "});"
            ]
          }
        }
